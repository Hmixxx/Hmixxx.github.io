---
import { url } from '@/lib/url';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import '@/theme/styles/content.css';
import '@/theme/styles/tag-plugins.css';
import Layout from '@/theme/Layout.astro';
import Comments from '@/theme/components/Comments.astro';
import Envelope from '@/theme/components/Envelope.astro';
import { optimize, imagePresets } from '@/lib/images';
import { site, aside, social } from '@/config';
import { Icon } from 'astro-icon/components';

export const getStaticPaths = (async () => {
  return (await getCollection('pages')).map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const type = page.data.type;
const avatar = type === 'about' ? await optimize(site.avatar, imagePresets.avatar) : undefined;
const isEmpty = !page.body?.trim();
const titles: Record<string, string> = { about: '关于', link: '友情链接' };
const title = titles[type ?? ''] ?? page.data.title;
---

<Layout title={title} header="page" topImg={page.data.top_img}>
  <div class="card page-card">
    {type === 'envelope' && <Envelope />}

    {
      type === 'about' && isEmpty && (
        <div class="about-card">
          <img src={avatar?.src} srcset={avatar?.srcset} alt={site.author} width="120" height="120" />
          <h1>{site.author}</h1>
          <p>{site.subtitle}</p>
          <div class="about-social" aria-label="社交平台链接">
            {social.map((s) => (
              <a href={url(s.href)} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener" style={`--c:${s.color}`}>
                {s.image ? <img class={`social-image social-image--${s.label.toLowerCase()}`} src={url(s.image)} alt="" aria-hidden="true" /> : <Icon name={s.icon} />}
                <span>{s.href}</span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    {type === 'link' && isEmpty && <p class="empty-hint">暂无友链，欢迎在下方留言交换～</p>}

    <div id="article-container" class="article-container" data-pagefind-body={isEmpty ? undefined : ''}>
      <Content />
    </div>

    {page.data.comments && <Comments path={url(`/${page.id}/`)} />}
  </div>
</Layout>

<style>
  .about-card {
    text-align: center;
    line-height: 1.8;
  }
  .about-card img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
  .about-card h1 {
    margin-top: 10px;
    font-weight: 500;
  }
  .about-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }
  .about-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    color: var(--c);
    word-break: break-all;
  }
  :global(:root[data-theme='light']) .about-social a:has(.social-image--github),
  :global(:root[data-theme='light']) .about-social a:has(.social-image--steam) {
    color: #000;
  }
  :global(:root[data-theme='dark']) .about-social a:has(.social-image--github),
  :global(:root[data-theme='dark']) .about-social a:has(.social-image--steam) {
    color: #fff;
  }
  .about-social img,
  .about-social :global(svg) {
    flex: 0 0 auto;
    width: 1.3em;
    height: 1.3em;
    object-fit: contain;
  }
  :global(:root[data-theme='light']) .about-social img.social-image--github,
  :global(:root[data-theme='light']) .about-social img.social-image--steam {
    filter: none;
  }
  :global(:root[data-theme='dark']) .about-social img.social-image--github,
  :global(:root[data-theme='dark']) .about-social img.social-image--steam {
    filter: brightness(0) invert(1);
  }
  .empty-hint {
    text-align: center;
    color: var(--muted);
  }
</style>
