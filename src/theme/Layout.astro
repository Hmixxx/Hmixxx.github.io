---
import { url } from '@/lib/url';
import { optimize, imagePresets, type ImageSource } from '@/lib/images';
import { ClientRouter } from 'astro:transitions';
import './generated/lxgw.css';
import font from './generated/font.json';
import './styles/global.css';
import { iconCss } from './icons-css';
import { site, features } from '@/config';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import Aside from './components/Aside.astro';
import Rightside from './components/Rightside.astro';
import Search from './components/Search.astro';
import MusicPlayer from './components/MusicPlayer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageSource;
  /** 'home' = no banner; 'page' = banner with centered title; 'post' = banner with post info (slot "post-info") */
  header?: 'home' | 'page' | 'post';
  topImg?: ImageSource;
  aside?: boolean;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
}

const {
  title,
  description = site.description,
  image = site.avatar,
  header = 'page',
  topImg = site.topImg,
  aside = true,
  ogType = 'website',
  noindex = false,
  published,
  modified,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL((await optimize(image, imagePresets.social)).src, Astro.site).href;
---

<!doctype html>
<html lang={site.lang} data-theme="light" data-fallback-font={font.preload ? url('/fonts/lxgw/fallback.css') : undefined} data-body-font={font.body ? url(font.body) : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Cascade layer order, ahead of every stylesheet: the first stylesheet to
        name a layer fixes its priority, and route-split CSS (content.css on post
        pages) can be linked before global.css. Keep in sync with global.css. */}
    <style is:inline>@layer reset, tokens, base, layout, content, components, utilities;</style>
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(',')} />
    <meta name="author" content={site.author} />
    {font.preload && <link rel="preload" href={url(font.preload)} as="font" type="font/woff2" crossorigin="anonymous" />}
    {font.body && <noscript><link rel="stylesheet" href={url(font.body)} /></noscript>}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url(site.logo)} />
    <link rel="apple-touch-icon" href={url(site.logo)} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="alternate" type="application/atom+xml" title={site.title} href={url('/atom.xml')} />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b1410" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />

    <style set:html={iconCss}></style>

    {/* Apply saved theme / aside / read-mode before first paint (also after every client-side navigation). */}
    <script is:inline>
      (() => {
        const read = (key) => {
          try {
            const raw = localStorage.getItem(key);
            if (raw == null) return undefined;
            try {
              // Butterfly stored {value, expiry}; keep honouring it
              const o = JSON.parse(raw);
              if (o && typeof o === 'object' && 'value' in o) {
                if (o.expiry && Date.now() > o.expiry) return undefined;
                return o.value;
              }
              return o;
            } catch {
              return raw;
            }
          } catch {
            return undefined;
          }
        };
        const apply = (doc) => {
          const root = doc.documentElement;
          const savedTheme = read('theme');
          root.dataset.theme = savedTheme === 'dark' ? 'dark' : 'light';
          root.classList.toggle('hide-aside', read('aside-status') === 'hide');
        };
        apply(document);
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body
    data-power-mode={features.powerMode.enable ? JSON.stringify(features.powerMode) : undefined}
    data-busuanzi={features.busuanzi === true ? '' : features.busuanzi || undefined}
  >
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div id="page-loader" aria-label="页面加载中" role="status">
      <span class="page-loader-spinner"></span>
      <span>加载中</span>
    </div>
    <div id="web_bg" aria-hidden="true"></div>

    <Header kind={header} topImg={topImg} title={title}>
      <slot name="post-info" slot="post-info" />
    </Header>

    <div class:list={['layout', { 'no-aside': !aside }]}>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      {
        aside && (
          <Aside>
            <slot name="aside-top" slot="top" />
            <slot name="aside-sticky" slot="sticky" />
          </Aside>
        )
      }
    </div>

    <Footer />
    <Rightside />
    <Search />
    <MusicPlayer />

    <style is:global>
      #page-loader { position: fixed; inset: 0; z-index: 9999; display: grid; place-content: center; gap: 12px; color: var(--theme-color); background: color-mix(in srgb, var(--global-bg) 72%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); opacity: 1; transition: opacity .35s ease, visibility .35s ease; }
      #page-loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
      .page-loader-spinner { width: 42px; height: 42px; margin: auto; border: 3px solid color-mix(in srgb, var(--theme-color) 22%, transparent); border-top-color: var(--theme-color); border-radius: 50%; animation: page-loader-spin .8s linear infinite; }
      @keyframes page-loader-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) { .page-loader-spinner { animation: none; } }
    </style>
    <script is:inline>
      (() => {
        const hide = () => document.getElementById('page-loader')?.classList.add('is-hidden');
        if (document.readyState === 'complete') hide(); else addEventListener('load', hide, { once: true });
        document.addEventListener('astro:page-load', hide);
      })();
    </script>
    <script is:inline>
      (() => {
        const image = new Image();
        image.crossOrigin = 'anonymous';
        image.onload = () => {
          try {
            const canvas = document.createElement('canvas');
            const size = 32;
            canvas.width = canvas.height = size;
            const context = canvas.getContext('2d', { willReadFrequently: true });
            if (!context) return;
            context.drawImage(image, 0, 0, size, size);
            const pixels = context.getImageData(0, 0, size, size).data;
            let r = 0, g = 0, b = 0, count = 0;
            for (let i = 0; i < pixels.length; i += 4) {
              const brightness = (pixels[i] * 299 + pixels[i + 1] * 587 + pixels[i + 2] * 114) / 1000;
              if (pixels[i + 3] > 0 && brightness > 25 && brightness < 235) {
                r += pixels[i]; g += pixels[i + 1]; b += pixels[i + 2]; count++;
              }
            }
            if (!count) return;
            r = Math.round(r / count); g = Math.round(g / count); b = Math.round(b / count);
            const factor = Math.max(0.65, Math.min(1.35, 150 / Math.max(r * 0.299 + g * 0.587 + b * 0.114, 1)));
            r = Math.min(255, Math.round(r * factor));
            g = Math.min(255, Math.round(g * factor));
            b = Math.min(255, Math.round(b * factor));
            // The theme uses a hand-tuned lavender accent for this wallpaper.
            // Keep the sampling code as a fallback hook for future wallpapers.
          } catch { /* Canvas can be unavailable or blocked by browser privacy settings. */ }
        };
        image.src = document.documentElement.dataset.theme === 'dark' ? '/img/backgrounds/bg-dark.png' : '/img/backgrounds/bg-light.png';
      })();
    </script>
    <script>
      import './scripts/main';
    </script>
  </body>
</html>
