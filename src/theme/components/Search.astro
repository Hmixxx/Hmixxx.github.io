---
import { Icon } from 'astro-icon/components';
---

<dialog id="search-dialog" class="search-dialog" aria-label="站内搜索">
  <div class="search-panel">
    <div class="search-header">
      <span class="search-title">站内搜索</span>
      <button type="button" class="search-close" data-search-close aria-label="关闭搜索"><Icon name="fa6-solid:xmark" /></button>
    </div>
    <form class="search-form" role="search" onsubmit="return false">
      <Icon name="fa6-solid:magnifying-glass" class="search-icon" />
      <input type="search" name="q" placeholder="搜索文章" autocomplete="off" spellcheck="false" aria-label="搜索关键词" data-search-input />
    </form>
    <p class="search-stats" data-search-stats aria-live="polite"></p>
    <ol class="search-results" data-search-results></ol>
    <button type="button" class="btn search-more" data-search-more hidden>加载更多</button>
  </div>
</dialog>

<style>
  .search-dialog {
    width: min(680px, 92vw);
    max-height: min(78vh, 760px);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--card-border) 75%, transparent);
    border-radius: 16px;
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    color: var(--font-color);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    -webkit-backdrop-filter: saturate(1.5) blur(24px);
    backdrop-filter: saturate(1.5) blur(24px);
  }
  .search-dialog::backdrop {
    background: rgba(15, 23, 42, 0.38);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .search-dialog[open] {
    animation: search-in 0.25s var(--ease);
  }
  @keyframes search-in {
    from { opacity: 0; transform: translateY(-16px); }
  }
  @media (max-width: 768px) {
    .search-dialog { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; border-radius: 0; }
  }
  .search-panel {
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
    max-height: inherit;
  }
  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .search-title {
    font-size: 0.95em;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-highlight-color);
  }
  .search-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--light-grey) 55%, transparent);
    color: var(--muted);
  }
  .search-close:hover { color: var(--theme-hover); }
  .search-close :global(svg) { width: 18px; height: 18px; }
  .search-form {
    position: relative;
    margin-top: 16px;
  }
  .search-form :global(.search-icon) {
    position: absolute;
    top: 50%;
    left: 14px;
    width: 14px;
    height: 14px;
    transform: translateY(-50%);
    color: var(--muted);
  }
  .search-form input {
    width: 100%;
    padding: 10px 14px 10px 40px;
    border: 1px solid var(--light-grey);
    border-radius: 10px;
    outline: none;
    background: color-mix(in srgb, var(--card-solid-bg) 72%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08) inset;
    line-height: 1.5;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .search-form input:focus {
    border-color: var(--theme-color);
    background: var(--card-solid-bg);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--theme-color) 20%, transparent);
  }
  .search-stats {
    margin: 10px 4px 4px;
    font-size: 0.85em;
    color: var(--muted);
  }
  .search-results {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0 4px 0 0;
    overflow-y: auto;
    list-style: none;
  }
  .search-results :global(li) {
    margin: 4px 0;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 9px;
    transition: background 0.2s, border-color 0.2s;
  }
  .search-results :global(li:hover) {
    background: color-mix(in srgb, var(--theme-color) 9%, transparent);
    border-color: color-mix(in srgb, var(--theme-color) 18%, transparent);
  }
  .search-results :global(a.search-result-title) {
    display: block;
    font-weight: 700;
    color: var(--text-highlight-color);
    line-height: 1.6;
  }
  .search-results :global(a.search-result-title:hover) { color: var(--theme-color); }
  .search-results :global(.search-result-sub) {
    display: block;
    font-size: 0.85em;
    color: var(--muted);
  }
  .search-results :global(.search-result-excerpt) {
    margin: 2px 0 0;
    font-size: 0.9em;
    line-height: 1.7;
  }
  .search-results :global(mark) {
    background: transparent;
    color: var(--theme-hover);
    font-weight: 700;
  }
  .search-more {
    margin: 14px auto 0;
  }
</style>
